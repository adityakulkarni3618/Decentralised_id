# ==============================================================================
# DecentraID — Environment Configuration
# Copy this file to `.env` in the project root before running docker-compose.
# NEVER commit the real `.env` file — it contains secrets.
# ==============================================================================

# --- Core ---
ENVIRONMENT=development
DEBUG=true

# --- Database (docker-compose uses mongodb service hostname) ---
DATABASE_URL=mongodb://localhost:27017/did_platform

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_64_byte_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Field-level encryption (AES-256-GCM) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FIELD_ENCRYPTION_KEY=CHANGE_ME_generate_a_random_32_byte_key

# --- CORS ---
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Blockchain (defaults target the local Hardhat node started by
#     docker-compose's `hardhat-node` service) ---
WEB3_PROVIDER_URL=http://localhost:8545
CHAIN_ID=31337
# Hardhat's default first test account private key (LOCAL DEV ONLY — never
# reuse a well-known test key on a real network):
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
CREDENTIAL_REGISTRY_ADDRESS=
REVOCATION_REGISTRY_ADDRESS=
ISSUER_REGISTRY_ADDRESS=

# --- AI thresholds ---
FACE_MATCH_THRESHOLD=0.72
FRAUD_REVIEW_THRESHOLD=0.45
FRAUD_REJECT_THRESHOLD=0.75

# --- Uploads ---
MAX_UPLOAD_MB=8
UPLOAD_DIR=/tmp/did_uploads

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Optional: testnet deployment (contracts/) ---
SEPOLIA_RPC_URL=
REPORT_GAS=false
BACKEND_SERVICE_ADDRESS=
